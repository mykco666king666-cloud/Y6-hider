<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="vault_media" />
        <exclude domain="file" path="vault_thumbs" />
        <exclude domain="file" path=".vault_key.bin" />
        <exclude domain="database" path="obsidian_vault.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="vault_media" />
        <exclude domain="file" path="vault_thumbs" />
        <exclude domain="file" path=".vault_key.bin" />
        <exclude domain="database" path="obsidian_vault.db" />
    </device-transfer>
</data-extraction-rules>
